@model IEnumerable<Clinic_Management_System_MVC.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<style>
    body {
        background: #f6f8fc;
    }

    .page-header {
        background: linear-gradient(135deg, #0d6efd, #4f8cff);
        color: white;
        border-radius: 24px;
        padding: 35px;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(13, 110, 253, 0.18);
    }

        .page-header h1 {
            font-weight: 800;
            margin-bottom: 8px;
        }

        .page-header p {
            margin: 0;
            opacity: 0.9;
        }

    .content-card {
        background: white;
        border-radius: 22px;
        padding: 25px;
        border: 1px solid #e9edf5;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    }

    .top-actions {
        margin-bottom: 20px;
    }

    .add-btn {
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .custom-table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .custom-table thead th {
            background: #eef5ff;
            color: #0d6efd;
            border: none;
            font-weight: 700;
            padding: 15px;
        }

        .custom-table tbody td {
            padding: 15px;
            border-color: #edf0f5;
        }

        .custom-table tbody tr {
            transition: 0.2s;
        }

            .custom-table tbody tr:hover {
                background: #fafcff;
            }

    .name-cell {
        font-weight: 700;
        color: #212529;
    }

    .location-badge {
        background: #e9f2ff;
        color: #0d6efd;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .action-btn {
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        margin-right: 4px;
    }

    .empty-box {
        text-align: center;
        padding: 55px 20px;
        color: #6c757d;
    }

    .empty-icon {
        font-size: 45px;
        margin-bottom: 15px;
    }
</style>

<div class="container py-4">

    <div class="page-header">
        <h1>🏥 Departments</h1>
        <p>Manage the departments available in your clinic.</p>
    </div>

    <div class="content-card">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 top-actions">

            <div>
                <h4 class="fw-bold mb-1">Department List</h4>
                <p class="text-muted mb-0">
                    View and manage all clinic departments.
                </p>
            </div>

            <a asp-action="Create" class="btn btn-primary add-btn">
                + Add Department
            </a>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table custom-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Department Name</th>
                            <th>Location</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@item.Id</strong>
                                </td>

                                <td class="name-cell">
                                    @item.Name
                                </td>

                                <td>
                                    <span class="location-badge">
                                        📍 @item.Location
                                    </span>
                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-info btn-sm action-btn">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm action-btn">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm action-btn">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-box">

                <div class="empty-icon">
                    🏥
                </div>

                <h4 class="fw-bold">
                    No Departments Found
                </h4>

                <p>
                    Start by adding the first department to your clinic.
                </p>

                <a asp-action="Create" class="btn btn-primary add-btn">
                    + Add Department
                </a>

            </div>
        }

    </div>

</div>