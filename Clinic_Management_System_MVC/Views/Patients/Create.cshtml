@model Clinic_Management_System_MVC.Models.Patient

@{
    ViewData["Title"] = "Create Patient";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="mb-4">
                <h1 class="fw-bold mb-1">Create Patient</h1>
                <p class="text-muted">
                    Add a new patient to the clinic.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Patient Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter patient name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold">
                                Phone
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="Enter phone number" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter email address" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Create Patient
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}