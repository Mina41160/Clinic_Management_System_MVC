@model Clinic_Management_System_MVC.Models.Doctor

@{
    ViewData["Title"] = "Edit Doctor";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="mb-4">
                <h1 class="fw-bold mb-1">Edit Doctor</h1>
                <p class="text-muted">
                    Update the doctor's information and department.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Doctor Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter doctor name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DepartmentId"
                                   class="form-label fw-semibold">
                                Department
                            </label>

                            <select asp-for="DepartmentId"
                                    asp-items="ViewBag.Departments"
                                    class="form-select">

                                <option value="">
                                    -- Select Department --
                                </option>

                            </select>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-warning px-4">
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}