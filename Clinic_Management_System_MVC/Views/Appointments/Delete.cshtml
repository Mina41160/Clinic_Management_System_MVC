@model Clinic_Management_System_MVC.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="mb-4">
                <h1 class="fw-bold mb-1">Delete Appointment</h1>
                <p class="text-muted">
                    Please review the appointment information before deleting it.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <div class="alert alert-danger rounded-3">
                        Are you sure you want to delete this appointment?
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small">
                            Appointment Date
                        </label>

                        <h4 class="fw-bold mb-0">
                            @Model.AppointmentDate.ToString("dd/MM/yyyy hh:mm tt")
                        </h4>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small">
                            Doctor
                        </label>

                        <p class="fw-semibold mb-0">
                            @Model.Doctor?.Name
                        </p>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small">
                            Department
                        </label>

                        <p class="fw-semibold mb-0">
                            @Model.Doctor?.Department?.Name
                        </p>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small">
                            Patient
                        </label>

                        <p class="fw-semibold mb-0">
                            @Model.Patient?.Name
                        </p>
                    </div>

                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger px-4">
                                Delete Appointment
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>