
@model IEnumerable<Clinic_Management_System_MVC.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<style>
    body {
        background: #f6f8fc;
    }

    .page-header {
        background: linear-gradient(135deg, #6f42c1, #9b6de3);
        color: white;
        border-radius: 24px;
        padding: 35px;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(111, 66, 193, 0.18);
    }

        .page-header h1 {
            font-weight: 800;
            margin-bottom: 8px;
        }

        .page-header p {
            margin: 0;
            opacity: 0.9;
        }

    .content-card {
        background: white;
        border-radius: 22px;
        padding: 25px;
        border: 1px solid #e9edf5;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    }

    .add-btn {
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .custom-table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .custom-table thead th {
            background: #f5efff;
            color: #6f42c1;
            border: none;
            font-weight: 700;
            padding: 15px;
            white-space: nowrap;
        }

        .custom-table tbody td {
            padding: 15px;
            border-color: #edf0f5;
        }

        .custom-table tbody tr {
            transition: 0.2s;
        }

            .custom-table tbody tr:hover {
                background: #fdfbff;
            }

    .doctor-text {
        font-weight: 700;
        color: #212529;
    }

    .patient-text {
        font-weight: 600;
        color: #212529;
    }

    .department-badge {
        background: #ede3fa;
        color: #6f42c1;
        padding: 6px 10px;
        border-radius: 18px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .date-box {
        background: #f5efff;
        color: #6f42c1;
        border-radius: 12px;
        padding: 8px 12px;
        display: inline-block;
        font-weight: 700;
        font-size: 14px;
        line-height: 1.6;
    }

    .action-btn {
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        margin-right: 4px;
        margin-bottom: 4px;
    }

    .empty-box {
        text-align: center;
        padding: 55px 20px;
        color: #6c757d;
    }

    .empty-icon {
        font-size: 45px;
        margin-bottom: 15px;
    }
</style>


<div class="container py-4">

    <!-- Page Header -->

    <div class="page-header">

        <h1>📅 Appointments</h1>

        <p>
            Manage clinic appointments between doctors and patients.
        </p>

    </div>


    <!-- Main Content -->

    <div class="content-card">

        <!-- Top Section -->

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

            <div>

                <h4 class="fw-bold mb-1">
                    Appointment List
                </h4>

                <p class="text-muted mb-0">
                    View and manage all scheduled clinic appointments.
                </p>

            </div>


            <a asp-action="Create"
               class="btn btn-secondary add-btn">

                + New Appointment

            </a>

        </div>


        <!-- Appointments Table -->
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table custom-table">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Doctor</th>

                            <th>Department</th>

                            <th>Patient</th>

                            <th>Date & Time</th>

                            <th>Actions</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- ID -->

                                <td>
                                    <strong>
                                        @item.Id
                                    </strong>
                                </td>


                                <!-- Doctor -->

                                <td class="doctor-text">

                                    👨‍⚕️ @item.Doctor?.Name

                                </td>


                                <!-- Department -->

                                <td>

                                    <span class="department-badge">

                                        🏥 @item.Doctor?.Department?.Name

                                    </span>

                                </td>


                                <!-- Patient -->

                                <td class="patient-text">

                                    🧑 @item.Patient?.Name

                                </td>


                                <!-- Date -->

                                <td>

                                    <span class="date-box">

                                        📅 @item.AppointmentDate.ToString("dd MMM yyyy")

                                        <br />

                                        ⏰ @item.AppointmentDate.ToString("hh:mm tt")

                                    </span>

                                </td>


                                <!-- Actions -->

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-info btn-sm action-btn">

                                        Details

                                    </a>


                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm action-btn">

                                        Edit

                                    </a>


                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm action-btn">

                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- Empty State -->

            <div class="empty-box">

                <div class="empty-icon">
                    📅
                </div>

                <h4 class="fw-bold">
                    No Appointments Found
                </h4>

                <p>
                    Start by creating the first appointment.
                </p>

                <a asp-action="Create"
                   class="btn btn-secondary add-btn">

                    + New Appointment

                </a>

            </div>
        }

    </div>

</div>